# -----------------------------------------------------------------------------
# Site
# Set this to the real domain before launch, e.g. https://digizenk.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true = redirect visitors to Spanish/English based on their browser language
NEXT_PUBLIC_LOCALE_DETECTION=false

# -----------------------------------------------------------------------------
# Social links (optional — empty ones are hidden in the footer)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# -----------------------------------------------------------------------------
# Analytics and ads (optional — leave empty to disable)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=

# -----------------------------------------------------------------------------
# Email sign-ups — https://resend.com
# Without RESEND_API_KEY and ADMIN_EMAIL the site still works, but the sign-up
# form shows "Sign-ups aren't switched on yet".
# ADMIN_EMAIL must be on a domain you've verified in Resend.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
ADMIN_EMAIL=
RESEND_AUDIENCE_ID=
# Download link for the free prompt pack, sent in the welcome email
FREE_PACK_URL=
# Any long random string; signs unsubscribe links so they can't be forged.
# Generate one with: openssl rand -base64 32
UNSUBSCRIBE_SECRET=

# -----------------------------------------------------------------------------
# Spam protection for sign-ups (optional) — https://upstash.com
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_NEWSLETTER_RATE_LIMIT_KEY=newsletter-rate-limit
DAY_MAX_SUBMISSIONS=10
